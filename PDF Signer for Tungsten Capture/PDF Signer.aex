[Modules]
PDF Signer

[PDF Signer]
RuntimeProgram=PDFSigner.exe
ModuleID=DocSoft.PDFSigner
Description=Module for electronically signing PDF documents
Version=11.2
SupportsNonImageFiles=True
SupportsTableFields=True
Function=Validation
SetupProgram = PDFSigner Setup

[PDFSigner Setup]
