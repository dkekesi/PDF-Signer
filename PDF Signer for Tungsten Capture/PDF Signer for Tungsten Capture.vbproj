<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Sub Main</StartupObject>
    <RootNamespace>PDFSigner</RootNamespace>
    <AssemblyName>PDFSigner</AssemblyName>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <LangVersion>latest</LangVersion>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>Off</OptionInfer>
    <Configurations>Debug;Release;FullRelease</Configurations>
    <Platforms>AnyCPU;x86</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <ApplicationIcon>PDFSigner.ico</ApplicationIcon>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <ProjectGuid>{DE276830-C34D-4F84-B2DD-142FFEB6A3FB}</ProjectGuid>
    <!-- Assembly info (migrated from My Project\AssemblyInfo.vb) -->
    <AssemblyTitle>PDF Signer for Tungsten Capture</AssemblyTitle>
    <Company>Doc-Soft Kkt.</Company>
    <Product>eWay</Product>
    <Copyright>Copyright © Doc-Soft Kkt. 2025.</Copyright>
    <Version>11.2.0.4836</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\Debug\</OutputPath>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'FullRelease|AnyCPU'">
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\FullRelease\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- Assembly-level attributes not covered by SDK properties -->
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisible">
      <_Parameter1>False</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.Guid">
      <_Parameter1>9c7a4348-dfdf-4280-b7c1-b67a785d11c5</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Resources.NeutralResourcesLanguage">
      <_Parameter1></_Parameter1>
    </AssemblyAttribute>
    <!-- TallComponents PDFControls.NET 2.0 Professional Client Application Key -->
    <AssemblyAttribute Include="TallComponents.Licensing.PDFControlsLicense">
      <_Parameter1>PDFControls.NET 2.0 Professional Client Application Key</_Parameter1>
      <_Parameter2>34Vqj+glt9-1A9Tq9BmoN+++</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Kofax.Capture.SDK.CustomModule">
      <HintPath>..\lib\Kofax\Kofax.Capture.SDK.CustomModule.dll</HintPath>
    </Reference>
    <Reference Include="Kofax.Capture.SDK.Data">
      <HintPath>..\lib\Kofax\Kofax.Capture.SDK.Data.dll</HintPath>
    </Reference>
    <Reference Include="Kofax.DBLite">
      <HintPath>..\lib\Kofax\Kofax.DBLite.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <!-- Explicit mscorlib keeps it in ReferencePath for Fody/Costura ("Could not find 'System.Object'" otherwise) -->
    <Reference Include="mscorlib" />
    <Reference Include="nsoftware.SecureBlackbox">
      <HintPath>..\lib\nsoftware.SecureBlackbox.dll</HintPath>
    </Reference>
    <Reference Include="PDFStreamer.WCFCommon">
      <HintPath>..\lib\PDF Streamer\PDFStreamer.WCFCommon.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    <Reference Include="System.EnterpriseServices" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Web.Services" />
    <Reference Include="TallComponents.PDF.Controls.WinForms">
      <HintPath>..\Lib\TallComponents.PDF.Controls.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PDF Signer for Tungsten Capture Common\PDF Signer for Tungsten Capture Common.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Costura.Fody">
      <Version>6.2.0</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DevExpress.Win.Grid" Version="25.2.8" />
    <PackageReference Include="DevExpress.Win.PdfViewer" Version="25.2.8" />
    <PackageReference Include="Fody">
      <Version>6.9.3</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog">
      <Version>6.1.3</Version>
    </PackageReference>
    <PackageReference Include="NLog.WindowsIdentity">
      <Version>6.0.2</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- licenses.licx is not part of the default globs; it drives LC.exe license compilation -->
    <EmbeddedResource Include="My Project\licenses.licx" />
    <None Remove="My Project\licenses.licx" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Language\GUIText.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GUIText.Designer.vb</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Language\Messages.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Messages.Designer.vb</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="My Project\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
    <None Update="Service References\MNBSignerServiceReference\Reference.svcmap">
      <Generator>WCF Proxy Generator</Generator>
      <LastGenOutput>Reference.vb</LastGenOutput>
    </None>
    <None Update="Service References\PDFStreamerServiceReference\Reference.svcmap">
      <Generator>WCF Proxy Generator</Generator>
      <LastGenOutput>Reference.vb</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <WCFMetadata Include="Service References\" />
    <WCFMetadataStorage Include="Service References\MNBSignerServiceReference\" />
    <WCFMetadataStorage Include="Service References\PDFStreamerServiceReference\" />
  </ItemGroup>
  <!-- Dev-machine convenience deploy; skip with /p:CopyToCaptureBin=false (needs admin + installed Capture) -->
  <Target Name="CopyToCaptureBin" AfterTargets="PostBuildEvent" Condition="'$(CopyToCaptureBin)' != 'false'">
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;C:\Program Files (x86)\Tungsten\Capture\Bin\&quot;" />
  </Target>
  <ItemGroup>
    <Analyzer Include="C:\Program Files\DevExpress 25.2\Components\Offline Packages\devexpress.data\25.2.4\analyzers\dotnet\DevExpress.Generator.dll" Visible="false" Condition="Exists('C:\Program Files\DevExpress 25.2\Components\Offline Packages\devexpress.data\25.2.4\analyzers\dotnet\DevExpress.Generator.dll')" />
  </ItemGroup>
</Project>
