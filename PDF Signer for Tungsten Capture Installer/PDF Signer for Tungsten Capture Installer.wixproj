<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>PDFSignerSetup</OutputName>
    <InstallerPlatform>x86</InstallerPlatform>
    <Platforms>x86</Platforms>
    <OutputPath>bin\</OutputPath>
    <!-- Generated webhelp harvested by Help.wxs; lives at the repo root -->
    <DefineConstants>$(DefineConstants);SourceDirHU=$(MSBuildThisFileDirectory)..\Help\Output\Online Help</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
