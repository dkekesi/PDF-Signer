<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>PDFSignerSetup</OutputName>
    <InstallerPlatform>x86</InstallerPlatform>
    <Platforms>x86</Platforms>
    <OutputPath>bin\</OutputPath>
    <!-- SourceDirHU: generated webhelp harvested by Help.wxs (repo root).
         ProductVersion: the product-wide $(Version) from Directory.Build.props, used as the MSI package version. -->
    <DefineConstants>$(DefineConstants);SourceDirHU=$(MSBuildThisFileDirectory)..\Help\Output\Online Help;ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
