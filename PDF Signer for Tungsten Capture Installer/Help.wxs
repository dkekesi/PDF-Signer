<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Replaces the WiX3 HeatDirectory-generated component list: WiX v4+ removed heat;
       the Files wildcard harvests the generated webhelp at build time instead. -->
  <Fragment>
    <ComponentGroup Id="OnlineHelp" Directory="Dir_Help">
      <Files Include="$(var.SourceDirHU)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
