<?xml version="1.0" encoding="utf-8"?>
<CatapultSkin
  Version="2"
  SkinType="WebHelp2"
  Comment="HTML5 skin"
  Anchors="Width,Height"
  Width="800"
  Height="600"
  Top="0"
  Left="0"
  Bottom="0"
  Right="0"
  Tabs="TOC"
  DefaultTab="TOC"
  UseBrowserDefaultSize="true"
  UseDefaultBrowserSetup="True"
  AutoSyncTOC="true"
  CommentsInTopic="false"
  DisplayCommunitySearchResults="false"
  DisplayNotificationOptions="false">
  <Stylesheet>
    <Resources>
      <Resource
        Name="eWayLogo2_mini.png"></Resource>
      <Resource
        Name="eWayLogo2_white.png"></Resource>
      <Resource
        Name="eWayLogo2_white_mini.png"></Resource>
      <Resource
        Name="eWayLogo_white_mini.png"></Resource>
      <Resource
        Name="HelpLogo.png"></Resource>
      <Resource
        Name="HelpLogo_1.png"></Resource>
    </Resources>
    <Styles>
      <Style
        Name="Logo">
        <Properties>
          <Property
            Name="BackgroundImage">url('HelpLogo_1.png')</Property>
        </Properties>
      </Style>
    </Styles>
  </Stylesheet>
  <Strings>
    <Stylesheet
      lang="hu">
      <Stylesheet>
        <Styles>
          <Style
            Name="Search Input">
            <Properties>
              <Property
                Name="Placeholder">Keresés</Property>
            </Properties>
          </Style>
          <Style
            Name="Search Submit Button">
            <Properties>
              <Property
                Name="Tooltip">Keresés</Property>
            </Properties>
          </Style>
          <Style
            Name="ToolbarItem">
            <Classes>
              <StyleClass
                Name="Print">
                <Properties>
                  <Property
                    Name="Tooltip">Nyomtat</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="RemoveHighlight">
                <Properties>
                  <Property
                    Name="Tooltip">Kiemelés elrejtése</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="ExpandAll">
                <Properties>
                  <Property
                    Name="Tooltip">Mindent kinyit</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="CollapseAll">
                <Properties>
                  <Property
                    Name="Tooltip">Mindent bezár</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="CurrentTopicIndex">
                <Properties>
                  <Property
                    Name="Format">{n} / {total}</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="Login">
                <Properties>
                  <Property
                    Name="Tooltip">Belépés</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="NextTopic">
                <Properties>
                  <Property
                    Name="Tooltip">Következőre lép</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="PreviousTopic">
                <Properties>
                  <Property
                    Name="Tooltip">Előzőre lép</Property>
                </Properties>
              </StyleClass>
            </Classes>
          </Style>
          <Style
            Name="Navigation Tab">
            <Classes>
              <StyleClass
                Name="TOC">
                <Properties>
                  <Property
                    Name="Label">Tartalom</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="Community">
                <Properties>
                  <Property
                    Name="Label">Közösség</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="Glossary">
                <Properties>
                  <Property
                    Name="Label">Szószedet</Property>
                </Properties>
              </StyleClass>
            </Classes>
          </Style>
          <Style
            Name="Feedback User Profile Button">
            <Classes>
              <StyleClass
                Name="Cancel">
                <Properties>
                  <Property
                    Name="Label">Mégsem</Property>
                </Properties>
              </StyleClass>
            </Classes>
          </Style>
          <Style
            Name="Search Heading">
            <Properties>
              <Property
                Name="Format">A {query} kifejezésre {total_results} találat érkezett.</Property>
            </Properties>
          </Style>
          <Style
            Name="Glossary Search Input">
            <Properties>
              <Property
                Name="Placeholder">Keresés</Property>
            </Properties>
          </Style>
          <Style
            Name="Index Entry See Also Reference">
            <Properties>
              <Property
                Name="Label">Továbbá</Property>
            </Properties>
          </Style>
          <Style
            Name="Index Entry See Reference">
            <Properties>
              <Property
                Name="Label">Lásd</Property>
            </Properties>
          </Style>
          <Style
            Name="Index Search Input">
            <Properties>
              <Property
                Name="Placeholder">Keresés</Property>
            </Properties>
          </Style>
        </Styles>
      </Stylesheet>
    </Stylesheet>
    <Stylesheet
      lang="he">
      <Stylesheet>
        <Resources>
          <Resource
            Name="eWayLogo2_mini.png"></Resource>
          <Resource
            Name="eWayLogo2_white.png"></Resource>
          <Resource
            Name="eWayLogo2_white_mini.png"></Resource>
        </Resources>
        <Styles>
          <Style
            Name="Logo">
            <Properties>
              <Property
                Name="BackgroundImage">url('eWayLogo2_white_mini.png')</Property>
            </Properties>
          </Style>
        </Styles>
      </Stylesheet>
    </Stylesheet>
    <Stylesheet
      lang="en-us">
      <Stylesheet>
        <Resources>
          <Resource
            Name="eWayLogo2_mini.png"></Resource>
          <Resource
            Name="eWayLogo2_white.png"></Resource>
          <Resource
            Name="eWayLogo2_white_mini.png"></Resource>
        </Resources>
        <Styles>
          <Style
            Name="Logo">
            <Properties>
              <Property
                Name="BackgroundImage">url('eWayLogo2_white_mini.png')</Property>
            </Properties>
          </Style>
        </Styles>
      </Stylesheet>
    </Stylesheet>
  </Strings>
</CatapultSkin>